msgstr "Ordner für ICS-Datei"

msgctxt "HR Addon Settings"
msgid "Absolute Path of the folder in which the ICS file will be saved, for example: /home/xxxxxxxxxx/owncloud/calendar/. Make sure this folder is writable by frappe user. Leave this field empty if you want to make the file public."
msgstr "Absoluter Pfad des Ordners, in dem die ICS-Datei gespeichert wird, z. B. /home/xxxxxxxxxx/owncloud/calendar/. Der Ordner muss für den Benutzer „frappe“ beschreibbar sein. Leer lassen, um die Datei öffentlich bereitzustellen."

msgctxt "HR Addon Settings"
msgid "Download ICS File"
msgstr "ICS-Datei herunterladen"

msgctxt "HR Addon Settings"
msgid "Generate Workdays automatically"
msgstr "Arbeitstage automatisch erzeugen"

msgctxt "HR Addon Settings"
msgid "Generate Workdays for past 7 days now"
msgstr "Arbeitstage der letzten 7 Tage jetzt erzeugen"

msgctxt "HR Addon Settings"
msgid "It will be generated for every Employee"
msgstr "Wird für alle Mitarbeiter erzeugt"

msgctxt "HR Addon Settings"
msgid "Day"
msgstr "Wochentag"

msgctxt "HR Addon Settings"
msgid "Time"
msgstr "Uhrzeit (Stunde)"

